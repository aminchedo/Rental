# Persian Chat Application - Environment Configuration

# =============================================================================
# Backend API Configuration
# =============================================================================
PORT=3001
NODE_ENV=development

# =============================================================================
# Search API Integration (Step 4)
# =============================================================================
# Enable/disable search retrieval for RAG (Retrieval-Augmented Generation)
SEARCH_ENABLED=true

# Your custom search API URL
# Example: https://api.your-search-service.com/search
SEARCH_API_URL=

# API key for your search service
SEARCH_API_KEY=

# =============================================================================
# Speech-to-Text (STT) Configuration
# =============================================================================
# STT service type: 'local', 'whisper', 'external'
STT_SERVICE=local

# For external STT API (optional)
STT_API_URL=
STT_API_KEY=

# Audio processing settings
STT_SAMPLE_RATE=16000
STT_MAX_FILE_SIZE_MB=10

# =============================================================================
# Text-to-Speech (TTS) Configuration
# =============================================================================
# TTS service type: 'local', 'espeak', 'external'
TTS_SERVICE=local

# For external TTS API (optional)
TTS_API_URL=
TTS_API_KEY=

# Audio generation settings
TTS_SAMPLE_RATE=16000
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_SPEED=1.0

# =============================================================================
# Model Configuration
# =============================================================================
MODEL_PATH=models/persian-chat
MODEL_MAX_LENGTH=512
MODEL_TEMPERATURE=0.3

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
LOG_DIR=logs

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Dataset Configuration (for training)
# =============================================================================
# Enable/disable specific datasets
HAMSHAHRI_ENABLED=false
GOOGLE_DATA_ENABLED=true

# =============================================================================
# Security Configuration
# =============================================================================
# API rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# JWT secret (for authentication, if implemented)
JWT_SECRET=

# =============================================================================
# Production Configuration
# =============================================================================
# Set to true in production
PRODUCTION=false

# SSL/HTTPS configuration (for production)
SSL_CERT_PATH=
SSL_KEY_PATH=

# =============================================================================
# Development Configuration
# =============================================================================
# Enable debug mode
DEBUG=false

# Enable development features
DEV_MODE=true
